# ==============================================================================
# NODEBRICKS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# IMPORTANT:
# - Copy this file to .env.local for local development:
#     cp .env.example .env.local
# - DO NOT commit real secrets or .env.local to Git.
# - In production (Vercel / Netlify / VPS), configure these variables via the
#   deployment platform's secure Environment Variables dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT SUPABASE (Exposed to the browser - RLS protected)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY PRIVILEGED SUPABASE (Strictly never exposed to the frontend)
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key

# ------------------------------------------------------------------------------
# 3. WHATSAPP BUSINESS API (Server-side alerts for student absence)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id

# ------------------------------------------------------------------------------
# 4. INSTITUTION TIMEZONE (Default: Asia/Kolkata)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata
